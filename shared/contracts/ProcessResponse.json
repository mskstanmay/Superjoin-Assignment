{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "docling",
            "blocks",
            "chunks",
            "candidates",
            "diagnostics"
          ],
          "title": "Kind",
          "type": "string"
        },
        "storage_key": {
          "pattern": "^[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*\\.[A-Za-z0-9]+$",
          "title": "Storage Key",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "storage_key",
        "sha256",
        "size_bytes",
        "schema_version"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "Counts": {
      "additionalProperties": false,
      "properties": {
        "pages_processed": {
          "minimum": 0,
          "title": "Pages Processed",
          "type": "integer"
        },
        "pages_total": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pages Total"
        },
        "chunks_processed": {
          "minimum": 0,
          "title": "Chunks Processed",
          "type": "integer"
        },
        "facts_accepted": {
          "minimum": 0,
          "title": "Facts Accepted",
          "type": "integer"
        },
        "facts_rejected": {
          "minimum": 0,
          "title": "Facts Rejected",
          "type": "integer"
        },
        "comparisons_completed": {
          "minimum": 0,
          "title": "Comparisons Completed",
          "type": "integer"
        },
        "comparisons_failed": {
          "minimum": 0,
          "title": "Comparisons Failed",
          "type": "integer"
        }
      },
      "required": [
        "pages_processed",
        "pages_total",
        "chunks_processed",
        "facts_accepted",
        "facts_rejected",
        "comparisons_completed",
        "comparisons_failed"
      ],
      "title": "Counts",
      "type": "object"
    },
    "ProcessingIssue": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "stage": {
          "enum": [
            "document_understanding",
            "extraction",
            "normalization",
            "matching",
            "reasoning"
          ],
          "title": "Stage",
          "type": "string"
        },
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "affected_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Affected Ids",
          "type": "array"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "observed_problem": {
          "minLength": 1,
          "title": "Observed Problem",
          "type": "string"
        },
        "action_taken": {
          "minLength": 1,
          "title": "Action Taken",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "resolution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Resolution"
        },
        "artifact_key": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*\\.[A-Za-z0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Artifact Key"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "run_id",
        "stage",
        "code",
        "affected_ids",
        "severity",
        "observed_problem",
        "action_taken",
        "retryable",
        "resolution",
        "artifact_key",
        "created_at"
      ],
      "title": "ProcessingIssue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "document_id": {
      "format": "uuid",
      "title": "Document Id",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "lease_token": {
      "format": "uuid",
      "title": "Lease Token",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "partially_completed",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "counts": {
      "$ref": "#/$defs/Counts"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/ProcessingIssue"
      },
      "title": "Issues",
      "type": "array"
    }
  },
  "required": [
    "contract_version",
    "request_id",
    "document_id",
    "run_id",
    "lease_token",
    "status",
    "artifacts",
    "counts",
    "issues"
  ],
  "title": "ProcessResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
