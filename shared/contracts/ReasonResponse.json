{
  "$defs": {
    "DimensionComparison": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "minLength": 1,
          "title": "Dimension",
          "type": "string"
        },
        "fact_a": {
          "$ref": "#/$defs/JsonValue"
        },
        "fact_b": {
          "$ref": "#/$defs/JsonValue"
        },
        "outcome": {
          "enum": [
            "aligned",
            "different",
            "unknown",
            "not_applicable"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "dimension",
        "fact_a",
        "fact_b",
        "outcome",
        "explanation",
        "evidence_ids"
      ],
      "title": "DimensionComparison",
      "type": "object"
    },
    "JsonValue": {},
    "ProcessingIssue": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "stage": {
          "enum": [
            "document_understanding",
            "extraction",
            "normalization",
            "matching",
            "reasoning"
          ],
          "title": "Stage",
          "type": "string"
        },
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "affected_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Affected Ids",
          "type": "array"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "observed_problem": {
          "minLength": 1,
          "title": "Observed Problem",
          "type": "string"
        },
        "action_taken": {
          "minLength": 1,
          "title": "Action Taken",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "resolution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Resolution"
        },
        "artifact_key": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*\\.[A-Za-z0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Artifact Key"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "run_id",
        "stage",
        "code",
        "affected_ids",
        "severity",
        "observed_problem",
        "action_taken",
        "retryable",
        "resolution",
        "artifact_key",
        "created_at"
      ],
      "title": "ProcessingIssue",
      "type": "object"
    },
    "Relationship": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "fact_a_id": {
          "format": "uuid",
          "title": "Fact A Id",
          "type": "string"
        },
        "fact_b_id": {
          "format": "uuid",
          "title": "Fact B Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "CORROBORATED",
            "CONTRADICTED",
            "RECONCILED",
            "UNCERTAIN"
          ],
          "title": "Type",
          "type": "string"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "dimensions": {
          "items": {
            "$ref": "#/$defs/DimensionComparison"
          },
          "minItems": 1,
          "title": "Dimensions",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confidence"
        },
        "confidence_source": {
          "enum": [
            "model",
            "rule"
          ],
          "title": "Confidence Source",
          "type": "string"
        },
        "unresolved_context": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved Context",
          "type": "array"
        },
        "supporting_evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Supporting Evidence Ids",
          "type": "array"
        },
        "reasoning_run_id": {
          "format": "uuid",
          "title": "Reasoning Run Id",
          "type": "string"
        },
        "reasoning_version": {
          "minLength": 1,
          "title": "Reasoning Version",
          "type": "string"
        },
        "model_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Version"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Prompt Version"
        },
        "input_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Input Hash",
          "type": "string"
        }
      },
      "required": [
        "id",
        "fact_a_id",
        "fact_b_id",
        "type",
        "explanation",
        "dimensions",
        "confidence",
        "confidence_source",
        "unresolved_context",
        "supporting_evidence_ids",
        "reasoning_run_id",
        "reasoning_version",
        "model_version",
        "prompt_version",
        "input_hash"
      ],
      "title": "Relationship",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "relationships": {
      "items": {
        "$ref": "#/$defs/Relationship"
      },
      "title": "Relationships",
      "type": "array"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/ProcessingIssue"
      },
      "title": "Issues",
      "type": "array"
    }
  },
  "required": [
    "contract_version",
    "request_id",
    "run_id",
    "relationships",
    "issues"
  ],
  "title": "ReasonResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
