{
  "$defs": {
    "Counts": {
      "additionalProperties": false,
      "properties": {
        "pages_processed": {
          "minimum": 0,
          "title": "Pages Processed",
          "type": "integer"
        },
        "pages_total": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pages Total"
        },
        "chunks_processed": {
          "minimum": 0,
          "title": "Chunks Processed",
          "type": "integer"
        },
        "facts_accepted": {
          "minimum": 0,
          "title": "Facts Accepted",
          "type": "integer"
        },
        "facts_rejected": {
          "minimum": 0,
          "title": "Facts Rejected",
          "type": "integer"
        },
        "comparisons_completed": {
          "minimum": 0,
          "title": "Comparisons Completed",
          "type": "integer"
        },
        "comparisons_failed": {
          "minimum": 0,
          "title": "Comparisons Failed",
          "type": "integer"
        }
      },
      "required": [
        "pages_processed",
        "pages_total",
        "chunks_processed",
        "facts_accepted",
        "facts_rejected",
        "comparisons_completed",
        "comparisons_failed"
      ],
      "title": "Counts",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "uploaded",
        "queued",
        "processing",
        "retry_wait",
        "completed",
        "partially_completed",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "stage": {
      "anyOf": [
        {
          "enum": [
            "document_understanding",
            "extraction",
            "normalization",
            "matching",
            "reasoning"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Stage"
    },
    "counts": {
      "$ref": "#/$defs/Counts"
    }
  },
  "required": [
    "status",
    "stage",
    "counts"
  ],
  "title": "ProcessingStatus",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
