{
  "$defs": {
    "Counts": {
      "additionalProperties": false,
      "properties": {
        "pages_processed": {
          "minimum": 0,
          "title": "Pages Processed",
          "type": "integer"
        },
        "pages_total": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pages Total"
        },
        "chunks_processed": {
          "minimum": 0,
          "title": "Chunks Processed",
          "type": "integer"
        },
        "facts_accepted": {
          "minimum": 0,
          "title": "Facts Accepted",
          "type": "integer"
        },
        "facts_rejected": {
          "minimum": 0,
          "title": "Facts Rejected",
          "type": "integer"
        },
        "comparisons_completed": {
          "minimum": 0,
          "title": "Comparisons Completed",
          "type": "integer"
        },
        "comparisons_failed": {
          "minimum": 0,
          "title": "Comparisons Failed",
          "type": "integer"
        }
      },
      "required": [
        "pages_processed",
        "pages_total",
        "chunks_processed",
        "facts_accepted",
        "facts_rejected",
        "comparisons_completed",
        "comparisons_failed"
      ],
      "title": "Counts",
      "type": "object"
    },
    "JsonValue": {},
    "ProcessingStatus": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "uploaded",
            "queued",
            "processing",
            "retry_wait",
            "completed",
            "partially_completed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "stage": {
          "anyOf": [
            {
              "enum": [
                "document_understanding",
                "extraction",
                "normalization",
                "matching",
                "reasoning"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Stage"
        },
        "counts": {
          "$ref": "#/$defs/Counts"
        }
      },
      "required": [
        "status",
        "stage",
        "counts"
      ],
      "title": "ProcessingStatus",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "original_filename": {
      "minLength": 1,
      "title": "Original Filename",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "storage_key": {
      "pattern": "^[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*\\.[A-Za-z0-9]+$",
      "title": "Storage Key",
      "type": "string"
    },
    "content_type": {
      "const": "application/pdf",
      "title": "Content Type",
      "type": "string"
    },
    "size_bytes": {
      "exclusiveMinimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    },
    "page_count": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Page Count"
    },
    "metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Metadata",
      "type": "object"
    },
    "processing": {
      "$ref": "#/$defs/ProcessingStatus"
    },
    "active_run_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Active Run Id"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "original_filename",
    "sha256",
    "storage_key",
    "content_type",
    "size_bytes",
    "page_count",
    "metadata",
    "processing",
    "active_run_id",
    "created_at",
    "updated_at"
  ],
  "title": "Document",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
