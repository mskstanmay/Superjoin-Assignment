{
  "name": "superjoin-challenge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "backend",
    "frontend",
    "shared"
  ],
  "scripts": {
    "build": "npm run build -w shared && npm run build -w backend && npm run build -w frontend",
    "test": "npm run test -w backend",
    "test:db": "node scripts/test-database.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "dev:processing": "node scripts/run-processing.mjs",
    "reset:mvp": "node scripts/reset-mvp.mjs",
    "migrate": "npm run migrate -w backend",
    "contracts:types": "node scripts/generate-contract-types.mjs"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.5.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.1",
    "json-schema-to-typescript": "16.0.0",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "yaml": "2.9.0"
  }
}
