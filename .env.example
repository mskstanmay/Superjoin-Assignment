# Copy to .env and replace CHANGE_ME. Never pass this whole file to processing.
POSTGRES_USER=superjoin
POSTGRES_DB=superjoin
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_PASSWORD
# Native Node connection only; Compose constructs its own private postgres URL.
# Use URL-safe characters or percent-encode the password in DATABASE_URL.
DATABASE_URL=postgresql://superjoin:CHANGE_ME_LOCAL_PASSWORD@127.0.0.1:5432/superjoin
PROCESSING_SERVICE_URL=http://127.0.0.1:8000
PORT=3000
NODE_ENV=development
UPLOAD_ROOT=../.runtime/uploads
ARTIFACT_ROOT=../.runtime/artifacts
MODEL_CACHE_DIR=../.runtime/model-cache
LOG_LEVEL=info
CONVERSION_CONCURRENCY=1
LLM_CONCURRENCY=1
LLM_MAX_OUTPUT_TOKENS=1200
JOB_HEARTBEAT_SECONDS=10
JOB_LEASE_SECONDS=60
JOB_MAX_ATTEMPTS=3
PROCESSING_TIMEOUT_SECONDS=300
HEALTH_TIMEOUT_MS=3000
MAX_PDF_PAGES=100
MAX_UPLOAD_BYTES=20000000
CHUNK_TOKEN_BUDGET=2048
DOCLING_DO_OCR=false
DOCLING_DO_TABLE_STRUCTURE=true
# Optional live semantic extraction. Keep the key only in local .env.
LIVE_LLM_ENABLED=false
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
# Browser uses Vite's proxy; this is the only browser-exposed configuration.
VITE_API_BASE_URL=/backend
BACKEND_PROXY_TARGET=http://127.0.0.1:3000
